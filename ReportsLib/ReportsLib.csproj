<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="EPPlus" Version="8.3.1" />
	  <PackageReference Include="itext7" Version="8.0.5" />
	  <PackageReference Include="itext7.bouncy-castle-adapter" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReportContracts\ReportContracts.csproj" />
  </ItemGroup>

	<Target Name="CopyToRPlugins" AfterTargets="Build">
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
			  DestinationFiles="$(SolutionDir)FormComponentDisplay\bin\Debug\net9.0-windows\RPlugins\$(AssemblyName).dll" />
	</Target>

</Project>
